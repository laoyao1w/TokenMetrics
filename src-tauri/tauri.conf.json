{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TokenMetrics",
  "version": "0.1.0",
  "identifier": "ai.tokenhall.desktop",
  "build": {
    "frontendDist": "../frontend",
    "devUrl": "http://127.0.0.1:4173",
    "beforeDevCommand": "npm run preview",
    "beforeBuildCommand": "npm run build:collector"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Token 统计",
        "width": 320,
        "height": 500,
        "minWidth": 280,
        "minHeight": 400,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "shadow": false,
        "center": true,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "useLocalToolsDir": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}